# --- Google Ads ---
# From the OAuth client you create in Google Cloud Console (APIs & Services > Credentials).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# From ads.google.com/aw/apicenter once your developer token is approved (Basic access).
GOOGLE_ADS_DEVELOPER_TOKEN=
# One-time: run `pnpm google:auth` after setting CLIENT_ID/SECRET above, it prints this.
GOOGLE_ADS_REFRESH_TOKEN=
# The account these tools operate on by default (10 digits, no dashes).
GOOGLE_ADS_CUSTOMER_ID=
# Only needed if GOOGLE_ADS_CUSTOMER_ID is a client account under a manager (MCC) account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Meta Ads ---
# From the App you create at developers.facebook.com (Settings > Basic).
# Used by meta_ads_get_account to debug the token. Not sent as the Marketing API caller.
META_APP_ID=
META_APP_SECRET=
# Long-lived System User token. Never commit a real value.
# Scopes: ads_management, ads_read, business_management, pages_show_list,
# pages_read_engagement, pages_manage_ads.
META_ACCESS_TOKEN=
# Numeric ad account id. act_ prefix is optional; the client adds it.
META_AD_ACCOUNT_ID=
# Optional defaults for creatives and conversion ad sets.
META_PAGE_ID=
META_PIXEL_ID=
# Optional Graph API version pin. Default is v26.0.
# META_GRAPH_API_VERSION=v26.0
